# Copy this file to .env (which is gitignored) and fill in your Supabase
# project's values: Dashboard -> Project Settings -> API.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the publishable/anon key — safe to expose
# in the client bundle. NEVER put the secret/service-role key in this file or
# in any VITE_-prefixed variable; it would ship straight to every visitor's
# browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
